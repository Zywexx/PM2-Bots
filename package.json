{
  "name": "palik-discord-bots",
  "version": "2.0.0",
  "description": "Discord Yönetim & Kayıt Çift Bot Sistemi (PM2)",
  "main": "src/kayit-bot.js",
  "scripts": {
    "start:kayit": "node src/kayit-bot.js",
    "start:moderasyon": "node src/moderasyon-bot.js",
    "deploy:kayit": "node src/deploy-kayit.js",
    "deploy:moderasyon": "node src/deploy-moderasyon.js",
    "deploy:all": "node src/deploy-kayit.js && node src/deploy-moderasyon.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "node-cron": "^3.0.3"
  }
}
